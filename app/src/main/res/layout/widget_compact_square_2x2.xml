<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_compact_square"
    android:clipToOutline="true">

    <!-- Layer 1: Full-Bleed Artwork Background (Click to open app) -->
    <ImageView
        android:id="@+id/widget_bg_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_compact_square"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/app_name" />

    <!-- Layer 2: Subtle bottom dark gradient scrim to make white text and icons pop -->
    <ImageView
        android:id="@+id/widget_gradient_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_gradient_scrim"
        android:scaleType="fitXY" />

    <!-- Layer 3: Track Information & Centered Bottom Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Song Title -->
        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:text="LofiQ Music" />

        <!-- Song Artist -->
        <TextView
            android:id="@+id/widget_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tap to play" />

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/widget_btn_circle_ripple"
                android:src="@drawable/ic_widget_prev"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_btn_circle_ripple"
                android:src="@drawable/ic_widget_play"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:contentDescription="Play Pause" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/widget_btn_circle_ripple"
                android:src="@drawable/ic_widget_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
