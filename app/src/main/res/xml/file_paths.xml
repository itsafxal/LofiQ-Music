<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Scoped APK update installer path (context.cacheDir/updates) -->
    <cache-path name="app_updates" path="updates" />
    
    <!-- Scoped temporary app cache for sharing/exports -->
    <cache-path name="cache_files" path="cache" />
    
    <!-- Scoped music download directories -->
    <external-files-path name="music_downloads" path="Music" />
    <external-path name="external_downloads" path="Download" />
</paths>
