{
  "name": "lofiq-security-tests",
  "version": "1.0.1",
  "private": true,
  "description": "Firestore Security Rules and Audit Tests for LofiQ",
  "scripts": {
    "test": "node test/firestore_rules_test.js",
    "test:emulator": "jest --testPathPattern=firestore_emulator --runInBand"
  },
  "jest": {
    "testMatch": [
      "**/test/**/*test.js"
    ],
    "testTimeout": 30000
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-admin": "^12.0.0",
    "jest": "^29.7.0"
  }
}
