{
  "name": "lofiq-tooling",
  "version": "1.0.2",
  "private": true,
  "description": "Release verification, dual deployment, and security test harness for LofiQ",
  "scripts": {
    "test": "node test/firestore_rules_test.js",
    "test:emulator": "jest --testPathPattern=firestore_emulator --runInBand",
    "validate:release": "node scripts/validate_release_artifacts.mjs",
    "verify:deployments": "node scripts/verify_dual_deployments.mjs"
  },
  "jest": {
    "testMatch": [
      "**/test/**/*test.js"
    ],
    "testTimeout": 30000
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-admin": "^12.0.0",
    "jest": "^29.7.0"
  }
}
